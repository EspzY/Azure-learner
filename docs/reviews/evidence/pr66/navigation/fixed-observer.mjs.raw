import {createRequire} from 'node:module';import fs from 'node:fs';const require=createRequire('/workspace/Azure-learner/package.json');const {chromium,expect}=require('@playwright/test');const {nb,ownerAcceptanceNb:a}=await import('/workspace/Azure-learner/src/content/nb.ts');const t=nb.foundationsV2,selector='#course-activities-computing > li > a[href$="topic=resource-bridge"]';
const browser=await chromium.launch();const records=[],runs=[];fs.mkdirSync('/workspace/azurelab-pr66/fixed-observer-traces',{recursive:true});
try{for(let n=0;n<20;n++){
const context=await browser.newContext({viewport:{width:1440,height:960}});await context.tracing.start({screenshots:true,snapshots:true,sources:true});let collision=false;
await context.exposeBinding('recordDuplicateNavigation',async({page},record)=>{collision=true;records.push({run:n,page:page.url(),...record});fs.writeFileSync('/workspace/azurelab-pr66/fixed-navigation-observer.json',JSON.stringify({at:new Date().toISOString(),records,runs},null,2));});
await context.addInitScript(selector=>{const inspect=()=>{const links=[...document.querySelectorAll(selector)];if(links.length>1){const skeleton=el=>{const parents=[];for(let p=el;p;p=p.parentElement)parents.push({tag:p.tagName,id:p.id,class:p.className,hidden:p.hidden,style:p.getAttribute('style'),display:getComputedStyle(p).display,visibility:getComputedStyle(p).visibility});return {text:el.textContent,html:el.outerHTML,rect:el.getBoundingClientRect().toJSON(),parents};};void window.recordDuplicateNavigation({href:location.href,readyState:document.readyState,at:performance.now(),links:links.map(skeleton),shells:document.querySelectorAll('.course-shell').length});}};new MutationObserver(inspect).observe(document,{subtree:true,childList:true,attributes:true,attributeFilter:['id','hidden','style']});},selector);
const p=await context.newPage();await p.addInitScript(()=>Object.defineProperty(window,'navigation',{value:undefined,configurable:true}));
try{
await p.goto('http://127.0.0.1:3000/learn/computing?topic=provisioning');await expect(p.locator('.related-activities')).toHaveCount(0);await p.locator(selector).click();await p.locator('.related-activities summary').click();await p.getByRole('link',{name:a.assessment,exact:true}).click();await p.getByRole('button',{name:t.beginAssessment,exact:true}).click();await p.goBack();await expect.poll(()=>p.evaluate(()=>JSON.parse(localStorage.getItem('azurelab.learning.foundations.v2')).events.some(e=>e.kind==='abandon'))).toBe(true);await p.goBack();await p.goForward();await p.goForward();await expect(p.locator('.v2-abandoned')).toBeVisible();await p.reload();
const native=await context.newPage();await native.goto('http://127.0.0.1:3000/learn/computing?topic=provisioning');await expect(native.locator('.related-activities')).toHaveCount(0);await native.locator(selector).click();runs.push({n,result:'completed',collision});
}catch(err){runs.push({n,result:'failed',error:String(err),collision});}
if(collision||runs.at(-1).result==='failed')await context.tracing.stop({path:'/workspace/azurelab-pr66/fixed-observer-traces/run-'+n+'.zip'});else await context.tracing.stop();await context.close();
console.log(n,runs.at(-1).result,collision,runs.at(-1).error??'');if(records.length>0)break;
}}finally{fs.writeFileSync('/workspace/azurelab-pr66/fixed-navigation-observer.json',JSON.stringify({at:new Date().toISOString(),records,runs},null,2));await browser.close();}
