<td><a href="#publicipaddress" data-linktype="self-bookmark">PublicIPAddress</a></td>
</tr>
<tr>
<td>migrationPhase</td>
<td>Migration phase of Public IP Address.</td>
<td>'Abort'<br>'Commit'<br>'Committed'<br>'None'<br>'Prepare'</td>
</tr>
<tr>
<td>natGateway</td>
<td>The NatGateway for the Public IP address.</td>
<td><a href="#natgateway" data-linktype="self-bookmark">NatGateway</a></td>
</tr>
<tr>
<td>publicIPAddressVersion</td>
<td>The public IP address version.</td>
<td>'IPv4'<br>'IPv6'</td>
</tr>
<tr>
<td>publicIPAllocationMethod</td>
<td>The public IP address allocation method.</td>
<td>'Dynamic'<br>'Static'</td>
</tr>
<tr>
<td>publicIPPrefix</td>
<td>The Public IP Prefix this Public IP Address should be allocated from.</td>
<td><a href="#subresource" data-linktype="self-bookmark">SubResource</a></td>
</tr>
<tr>
<td>servicePublicIPAddress</td>
<td>The service public IP address of the public IP address resource.</td>
<td><a href="#publicipaddress" data-linktype="self-bookmark">PublicIPAddress</a></td>
</tr>
</tbody>
</table>
