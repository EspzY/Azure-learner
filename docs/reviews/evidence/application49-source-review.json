  "claims": [
    {
      "id": "ATC01",
      "text": "Name resolution and network filtering are distinct from API authorization; an observed test supports only its declared path/operation.",
      "sources": ["AT03", "AT04", "AT05", "AT06", "AT07"]
    },
    {
      "id": "ATC02",
      "text": "A client holding a token does not establish that the target API accepts its claims. Validation is a server/API responsibility.",
      "sources": ["AT19"]
    },
    {
      "id": "ATC03",
      "text": "Azure Files supports qualified shared SMB access; supported identity/protocol/client/network conditions and concurrent application behavior must be tested.",
      "sources": ["AT09", "AT11", "AT12", "AT21"]
    },
    {
      "id": "ATC04",
      "text": "Blob object operations, a file share and VM block volumes have different client contracts. Both supplied supported adapters can be valid under the changed synthetic requirements.",
      "sources": ["AT09", "AT10", "AT11"]
    },
    {
      "id": "ATC05",
      "text": "Reservations discount matching usage; unused matching hours are not banked and a billing reservation is not a runtime capacity or availability guarantee.",
      "sources": ["AT14", "AT16", "AT18", "AT20"]
    },
    {
      "id": "ATC06",
      "text": "Spot can be interrupted and capacity is not guaranteed. Checkpoint/fallback and pilot cost figures are original declared scenario assumptions, not measured Azure data or a future savings proof.",
      "sources": ["AT14", "AT17"]
    }
  ],
